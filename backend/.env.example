# =============================================================================
# Wise Wolves Strict RAG System - Backend Configuration Example
# Copy this file to .env and provide your actual API keys and credentials.
# =============================================================================

# PostgreSQL with pgvector connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/copilot_db

# Primary LLM: OpenRouter (Default)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Secondary / Alternative LLM: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings Configuration
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# RAG Relevance Calibration
SIMILARITY_THRESHOLD=0.25
TOP_K=5
LLM_PROVIDER=openrouter

# Enterprise Strict Grounding Flags (Fail-closed)
WEB_SEARCH_ENABLED=false
MCP_TOOLS_ENABLED=false
GENERAL_KNOWLEDGE_ENABLED=false

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
